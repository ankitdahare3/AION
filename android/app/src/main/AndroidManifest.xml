<?xml version="1.0" encoding="utf-8"?>
<!-- DOC-002 §9 PR-02: platform permissions the setup wizard (T-004) walks the owner through. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Normal permission, granted automatically at install — no setup-wizard row needed, unlike
         the dangerous/special permissions below. Needed for ProviderRouter's real cloud calls
         (T-030/DOC-013) and the Gmail/Telegram plugins (T-102); genuinely never used before now. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- T-151 (EPIC 17) — real Calendar screen, reads CalendarProvider events the owner already has. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- PACKAGE_USAGE_STATS is granted via Settings.ACTION_USAGE_ACCESS_SETTINGS, never a runtime dialog. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- T-010 (DOC-011 §2/§4) — VoiceForegroundService is a real always-open microphone stream
         (openWakeWord/T-011 isn't built yet, so it reads and discards for now — see the service's
         own KDoc), so it genuinely needs both the FGS permission and its microphone sub-type
         (API 34+ requires declaring the specific type, not just the general one) plus
         POST_NOTIFICATIONS (API 33+) for its own foreground-service notification to be visible. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- T-121 finding — API 30+ package-visibility filtering made getLaunchIntentForPackage()
         (ActionDispatcher.launchApp, T-041) return null for nearly every installed app, including
         correct, present packages like com.google.android.youtube; latent since T-041 because
         com.android.settings (the only package earlier tests launched) is visible by default.
         Scoped to launchable apps — exactly what an automation assistant needs — rather than the
         Play-policy-restricted QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:name=".AionApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aion">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".svc.AionNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".security.KillSwitchOverlayService"
            android:exported="false" />

        <service
            android:name=".voice.VoiceForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".automation.AionAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
        </service>

    </application>

</manifest>
